# PawCRM Frontend — environment configuration
# Copy to .env.local for local development. Never commit .env.local.

# Base URL of the PawCRM backend, including the /api prefix.
#
# Outside production this defaults to http://localhost:5000/api, so a fresh
# clone runs with no setup. It is REQUIRED for production builds — see
# src/utils/env.ts.
#
# NEXT_PUBLIC_ variables are inlined into the client bundle at build time
# and are visible to anyone using the site. Never put a secret here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Buloo's own WhatsApp number, used by the "Ngobrol lewat WhatsApp" button on
# the landing page at /.
#
# The format wa.me wants: country code first, digits only, no + and no spaces.
# Anything else (+62, spaces, dashes) is stripped before use, so the readable
# form is safe to paste here too.
#
# Optional. Left unset, src/utils/env.ts falls back to the number below, so a
# fresh clone still has a working button.
NEXT_PUBLIC_PHONE_NUMBER=

# Browser key for the Google Maps JavaScript API + Geocoding API, behind
# "Pilih dari peta" on an antar-jemput address (/dashboard/layanan/antar-jemput/new,
# the till, and the invoice).
#
# Enable BOTH APIs on the same Google Cloud project:
#   - Maps JavaScript API  (draws the map)
#   - Geocoding API        (turns the pin into an address, and a search into a pin)
#
# ⚠️ THIS KEY IS PUBLIC — NEXT_PUBLIC_ inlines it into the client bundle, which
# is how a Maps browser key is meant to work. Protect it in Google Cloud Console
# instead, on the key itself:
#   - Application restriction: HTTP referrers — your own domains only
#     (http://localhost:3000/*, https://app.example.com/*)
#   - API restriction: the two APIs above, and nothing else
# Then cap the spend: APIs & Services → Quotas, set a daily request ceiling.
#
# Optional. Left unset, "Pilih dari peta" is shown disabled and every address
# can still be filled from the customer, the branch, or typed by hand.
GOOGLE_MAPS_API_KEY=
